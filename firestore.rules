rules_version = '2';

// The web app talks to Firestore directly (no server). Each learner can only read and write
// their own tree `users/{uid}/…`; everything else is closed. Lesson content is not in Firestore
// (static JSON on Hosting). Anyone can sign in with Google, but only accounts given the
// `learner` custom claim by `npm run user:grant` (or `migrate:sqlite`) can read or write.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.learner == true;
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    function isCard(d) {
      return d.due is timestamp
        && isNumber(d.stability) && isNumber(d.difficulty)
        && d.scheduledDays is int && d.learningSteps is int
        && d.reps is int && d.lapses is int
        && d.state in [0, 1, 2, 3]
        && (d.lastReview == null || d.lastReview is timestamp);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'level', 'dailyGoalMin', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.level in ['A2', 'A2+', 'B1']
        && request.resource.data.dailyGoalMin is int;

      match /lessonProgress/{slug} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.status in ['not_started', 'in_progress', 'completed']
          && request.resource.data.step is int
          && request.resource.data.updatedAt is timestamp;
      }

      match /words/{wordId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.lemma is string
          && isCard(request.resource.data);
      }

      match /dailyActivity/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == date;
      }

      // History logs: append-only.
      match /answers/{id} {
        allow read, create: if isOwner(uid);
      }
      match /reviewLogs/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.rating in [1, 2, 3, 4];
      }
    }
  }
}
