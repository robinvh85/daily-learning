{
  "name": "@daily-learning/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types and schemas shared by the web app and the content tooling.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "source": "./src/content.ts",
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./api": {
      "source": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./content-data": {
      "source": "./src/content-data.ts",
      "types": "./dist/content-data.d.ts",
      "default": "./dist/content-data.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
