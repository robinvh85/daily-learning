{
  "name": "daily-learning",
  "version": "0.1.0",
  "private": true,
  "description": "DailyLearning: English reading and listening practice (A2 to B1).",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @daily-learning/server\" \"npm run dev -w @daily-learning/web\"",
    "build": "npm run build -w @daily-learning/shared && npm run build -w @daily-learning/server -w @daily-learning/web",
    "start": "npm run start -w @daily-learning/server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run build -w @daily-learning/shared && npm run db:generate -w @daily-learning/server",
    "db:migrate": "tsx --conditions=source scripts/db-migrate.ts",
    "content:sync": "tsx --conditions=source scripts/content-sync.ts",
    "content:check-dict": "tsx --conditions=source scripts/content-check-dict.ts",
    "content:stats": "tsx --conditions=source scripts/content-stats.ts",
    "content:tts": "tsx --conditions=source scripts/tts.ts",
    "content:tts-words": "tsx --conditions=source scripts/tts-words.ts",
    "content:tts:voices": "tsx --conditions=source scripts/tts-voices.ts",
    "user:create": "tsx --conditions=source scripts/user-create.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
