{
  "name": "daily-learning",
  "version": "0.1.0",
  "private": true,
  "description": "DailyLearning: English reading and listening practice (A2 to B1).",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/content",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run content:build && concurrently -k -n emulators,web -c blue,green \"npm run emulators\" \"npm run dev -w @daily-learning/web\"",
    "emulators": "node scripts/emulators.mjs",
    "build": "npm run content:build && npm run build -w @daily-learning/web",
    "deploy": "npm run build && firebase deploy --only hosting,firestore --project \"${FIREBASE_PROJECT:-prod}\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-daily-learning \"npm run test:emulator -w @daily-learning/web\"",
    "test:e2e": "npm run content:build && npm run build:e2e -w @daily-learning/web && firebase emulators:exec --only auth,firestore,hosting --project demo-daily-learning \"playwright test\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:build": "tsx --conditions=source scripts/content-build.ts",
    "content:check": "tsx --conditions=source scripts/content-build.ts --check",
    "content:check-dict": "tsx --conditions=source scripts/content-check-dict.ts",
    "content:check-grammar": "tsx --conditions=source scripts/content-check-grammar.ts",
    "content:stats": "tsx --conditions=source scripts/content-stats.ts",
    "content:tts": "tsx --conditions=source scripts/tts.ts",
    "content:tts-words": "tsx --conditions=source scripts/tts-words.ts",
    "content:tts:voices": "tsx --conditions=source scripts/tts-voices.ts",
    "user:grant": "tsx --conditions=source scripts/user-grant.ts",
    "migrate:sqlite": "tsx --conditions=source scripts/migrate-sqlite-to-firestore.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
