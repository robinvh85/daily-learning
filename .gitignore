# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local data (SQLite DB, backups) - never commit
data/

# Secrets - never commit
.env
.env.*
!.env.example
secrets/

# Test output
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Logs and OS / editor files
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Claude local settings
.claude/settings.local.json

# Local scratch output (voice samples etc.)
tmp/

# TTS clip cache (plan 2.4): only the final audio.mp3 / words/*.mp3 are committed
content/.tts-cache.json
content/.tts-clips/
