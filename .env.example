# Copy to .env and adjust. Never commit .env.

# Address the server listens on. Keep 127.0.0.1 unless AUTH_MODE=password (plan 2.6).
HOST=127.0.0.1

# API server port. In dev, the web app runs on http://127.0.0.1:5173 (Vite) and
# proxies /api to this port. In production the server serves everything on this port.
PORT=3000

# SQLite database file, relative to the repo root. Created and migrated automatically
# on server start and by `npm run db:migrate` / `npm run content:sync`.
DB_PATH=./data/app.db

# none = single local user, no login (default) | password = login required (VPS).
# The server refuses to start when HOST is not localhost and AUTH_MODE=none.
# Create logins with: npm run user:create -- you@example.com
AUTH_MODE=none

# Name used in the Home greeting ("Chào Viet, …") for the default local user (AUTH_MODE=none).
# Applied on every server start. Leave empty to keep the current name (default "bạn").
USER_DISPLAY_NAME=

# Google Cloud Text-to-Speech API key, used only by the content:tts* scripts (Phase 3), never by
# the server. Create it in Google Cloud Console → APIs & Services → Credentials, restrict it to the
# Text-to-Speech API, and set a budget alert. Never commit it (.env is git-ignored).
GOOGLE_TTS_API_KEY=

# Abort a TTS run if it would send more characters than this (cached clips do not count).
TTS_MAX_CHARS=50000
