# Copy to .env and adjust. Never commit .env.
#
# The app itself needs no settings: in dev it uses the local Firebase emulators (demo project),
# in production Firebase Hosting serves the project config at /__/firebase/init.json.

# Google Cloud Text-to-Speech API key, used only by the content:tts* scripts (Phase 3), never by
# the app. Create it in Google Cloud Console → APIs & Services → Credentials, restrict it to the
# Text-to-Speech API, and set a budget alert. Never commit it (.env is git-ignored).
GOOGLE_TTS_API_KEY=

# Abort a TTS run if it would send more characters than this (cached clips do not count).
TTS_MAX_CHARS=50000
